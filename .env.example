# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
#
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, LiteLLM, a company gateway).
# The skills request `claude-sonnet-4-6`, so point this at a gateway that serves it,
# or change the model id in the skill scripts.

LLM_API_KEY=your-key-here
LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_MODEL=api-llama-4-scout   # default model for ad-hoc ask() calls
